# Route ONLY the MCP endpoint and its OAuth metadata on secret.getdumont.ai to
# the Secrets MCP on 127.0.0.1:3015. Everything else keeps going to OIDCWarden
# exactly as today. Not applied by any script: the owner merges it into the
# existing site block on vault-syd1 (see bootstrap-owner-steps.md, step 8,
# which starts with a discovery of how Caddy runs there).
#
# Merge shape: keep the existing site block and its settings; wrap the
# existing upstream in `handle { }` UNCHANGED and put the MCP handle BEFORE
# it. `handle` blocks are mutually exclusive; the matcher decides.

secret.getdumont.ai {
	# ...existing global settings of this site (tls, headers, logs) stay here...

	@secrets_mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @secrets_mcp {
		reverse_proxy 127.0.0.1:3015
	}

	handle {
		# The existing OIDCWarden upstream, exactly as it is today.
		reverse_proxy <EXISTING_VAULT_UPSTREAM>
	}
}
