# /etc/dumont-secrets-mcp.env on vault-syd1: root:root, mode 0600.
# Placeholders in <angle brackets>; the real ids are never committed here.
# No secret belongs in this file: the machine-account password is a separate
# file read by bw itself, and token introspection is not supported (any
# MCP_OIDC_INTROSPECTION_* line makes the service refuse to start).
# Plain KEY=value lines: no quotes, no spaces, no trailing comments.
# Fixed paths (BW_BIN, BW_APPDATA_DIR, BW_PASSWORD_FILE, SECRETS_MCP_POLICY_FILE,
# MCP_HTTP_HOST/PORT) come from the unit and should not be set here.

MCP_RESOURCE_URL=https://secret.getdumont.ai/mcp
MCP_ALLOWED_HOSTS=secret.getdumont.ai,127.0.0.1,localhost
MCP_OIDC_ISSUER=https://auth.getdumont.ai
MCP_OIDC_JWKS_URL=https://auth.getdumont.ai/oauth/v2/keys
# The DEDICATED ZITADEL project "Dumont Secrets MCP" (never the shared DCR project).
MCP_OIDC_AUDIENCE=<SECRETS_MCP_PROJECT_ID>
# The client id(s) of that project's own native app, comma separated.
MCP_OIDC_ALLOWED_CLIENT_IDS=<SECRETS_MCP_CLIENT_ID>
MCP_OIDC_ALLOWED_ORG_ID=<DUMONT_ZITADEL_ORG_ID>

# Role keys in that project (defaults shown).
SECRETS_MCP_ROLE_META=secrets_meta
SECRETS_MCP_ROLE_READER=secrets_reader
SECRETS_MCP_ROLE_WRITER=secrets_writer

# The vault as bw sees it. Default: the public URL (the proven path). The
# vault's loopback port is accepted but has not been tested with the CLI.
BW_SERVER_URL=https://secret.getdumont.ai
BW_EMAIL=<MACHINE_ACCOUNT_EMAIL>
# Optional: only consider collections of this organization.
# BW_ORGANIZATION_ID=<BITWARDEN_ORGANIZATION_ID>

SECRETS_MCP_ALLOW_SET=false
SECRETS_MCP_RATE_LIMIT=30
SECRETS_MCP_WRITE_RATE_LIMIT=10
