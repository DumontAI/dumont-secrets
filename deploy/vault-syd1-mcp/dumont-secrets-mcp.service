# Rendered and installed by apply-on-vault-syd1.sh (it replaces @NODE_BIN@ and
# @NODE_DIR@). Do not edit the installed copy by hand: the next apply replaces
# it and --show-release reports the difference as drift.
[Unit]
Description=Dumont Secrets MCP server (role-scoped vault access over MCP)
Documentation=https://github.com/DumontAI/dumont-secrets/tree/main/mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secrets-mcp
Group=secrets-mcp
# `current` is a symlink to releases/<sha>; systemd resolves it at start, so
# /proc/<pid>/cwd names the release this process is really running.
WorkingDirectory=/opt/dumont-secrets-mcp/current
# Fixed locations (the apply checks them). Values in the EnvironmentFile
# override these, but should not need to.
Environment=NODE_ENV=production
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=MCP_HTTP_HOST=127.0.0.1
Environment=MCP_HTTP_PORT=3015
Environment=BW_BIN=/usr/local/bin/bw
Environment=BW_APPDATA_DIR=/var/lib/dumont-secrets-mcp/bw
Environment=BW_PASSWORD_FILE=/etc/dumont-secrets-mcp/bw-password
Environment=SECRETS_MCP_POLICY_FILE=/etc/dumont-secrets-mcp/policy.json
# root:root 0600; read by systemd, never by the apply.
EnvironmentFile=/etc/dumont-secrets-mcp.env
ExecStart=@NODE_BIN@ /opt/dumont-secrets-mcp/current/dist/http.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# The bw CLI data dir (encrypted vault cache, device id) lives here, 0700.
StateDirectory=dumont-secrets-mcp
StateDirectoryMode=0700

# Hardening (the Bugit MCP unit, plus what a process holding a vault session
# key should have: no core dumps, no capabilities, nothing writable but its state).
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# MemoryDenyWriteExecute is deliberately absent: the V8 JIT needs W+X pages.

[Install]
WantedBy=multi-user.target
