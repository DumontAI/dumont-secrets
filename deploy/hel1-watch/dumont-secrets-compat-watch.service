[Unit]
Description=Dumont Secrets compat watch (Hangar SEC + Chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/dumont-secrets-watch
ExecStart=/usr/bin/python3 /home/deploy/dumont-secrets-watch/compat-watch.py --notify
Nice=10
